#!/bin/sh
# Firewall log collector for luci-app-log-viewer.
#
# Keeps a tmpfs ring of firewall log lines so unrelated syslog cannot evict
# them, streams `logread -f` instead of rescanning, and optionally appends new
# firewall lines to daily files on a mounted disk.
#
# The ring is rebuilt from logread only when it is missing (first boot). After
# a restart the collector resumes from the last line already on disk instead
# of appending the whole logread tail again.
set -eu

RING="${LOG_VIEWER_RING:-/tmp/log-viewer/events.ring}"
CAP="${LOG_VIEWER_RING_CAP:-500}"
STATUS_FILE="${LOG_VIEWER_STATUS:-/tmp/log-viewer/events.status}"
BUFFER="${LOG_VIEWER_BUFFER:-/tmp/log-viewer/persist.buffer}"
STATE_DIR="${LOG_VIEWER_STATE_DIR:-/tmp/log-viewer}"
STATS_FILE="$STATE_DIR/persist.stats"
PRUNE_STAMP="$STATE_DIR/persist.pruned"
LOCK_FILE="$STATE_DIR/history.lock"
PID_FILE="$STATE_DIR/history.pid"
TMP_DIR="${LOG_VIEWER_TMP:-/tmp}"
CONFIG=log-viewer.history
HISTORY_INIT="${LOG_VIEWER_HISTORY_INIT:-/etc/init.d/log-viewer-history}"

PERSIST_ENABLED=0
PERSIST_DIR=/srv/log-viewer
PERSIST_DAYS=7
PERSIST_MAX_MB=32
PERSIST_FILE=
PERSIST_TICK=0

case "$CAP" in ''|*[!0-9]*) CAP=500 ;; esac
[ "$CAP" -ge 1 ] || CAP=500
[ "$CAP" -le 5000 ] || CAP=5000

uci_get() { uci -q get "$1" 2>/dev/null || true; }

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n'
}

load_config() {
  PERSIST_ENABLED="${LOG_VIEWER_PERSIST:-0}"
  PERSIST_DIR="${LOG_VIEWER_PERSIST_DIR:-/srv/log-viewer}"
  PERSIST_DAYS="${LOG_VIEWER_PERSIST_DAYS:-7}"
  PERSIST_MAX_MB="${LOG_VIEWER_PERSIST_MAX_MB:-32}"
  if command -v uci >/dev/null 2>&1; then
    v="$(uci_get "$CONFIG.enabled")"
    [ "$v" = 1 ] && PERSIST_ENABLED=1
    v="$(uci_get "$CONFIG.directory")"
    [ -n "$v" ] && PERSIST_DIR="$v"
    v="$(uci_get "$CONFIG.days")"
    case "$v" in ''|*[!0-9]*) ;; *) PERSIST_DAYS=$v ;; esac
    v="$(uci_get "$CONFIG.max_mb")"
    case "$v" in ''|*[!0-9]*) ;; *) PERSIST_MAX_MB=$v ;; esac
    v="$(uci_get "$CONFIG.ring")"
    case "$v" in
      ''|*[!0-9]*) ;;
      *) [ "$v" -ge 100 ] && [ "$v" -le 5000 ] && CAP="$v" ;;
    esac
  fi
  if [ "${LOG_VIEWER_PERSIST_TEST:-0}" != 1 ]; then
    case "$PERSIST_DIR" in
      /srv/*|/srv|/mnt/*|/mnt|/media/*|/media|/etc/log-viewer/*|/etc/log-viewer|/tmp/*|/tmp) ;;
      *) PERSIST_ENABLED=0; PERSIST_DIR=/srv/log-viewer ;;
    esac
  fi
  case "$PERSIST_DAYS" in ''|*[!0-9]*) PERSIST_DAYS=7 ;; esac
  case "$PERSIST_MAX_MB" in ''|*[!0-9]*) PERSIST_MAX_MB=32 ;; esac
  [ "$PERSIST_DAYS" -le 3650 ] || PERSIST_DAYS=3650
  [ "$PERSIST_MAX_MB" -le 8192 ] || PERSIST_MAX_MB=8192
}

LOCK_HELD=0

# Take the writer lock unless this process already holds it. Callers keep the
# lock for the smallest possible window: the collector runs for days, so it
# must not hold a lock that `clear` or `update` need.
lock_take() {
  wait_for="${1:-5}"
  [ "$LOCK_HELD" = 1 ] && return 0
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  exec 9>"$LOCK_FILE" 2>/dev/null || return 0
  command -v flock >/dev/null 2>&1 || { LOCK_HELD=1; return 0; }
  flock -w "$wait_for" 9 2>/dev/null || return 1
  LOCK_HELD=1
  return 0
}

pid_running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null
}

read_log() {
  if command -v logread >/dev/null 2>&1; then
    logread -l 1500 2>/dev/null || true
    return 0
  fi
  for bin in /sbin/logread /usr/sbin/logread /usr/libexec/logread-ubox; do
    if [ -x "$bin" ]; then
      "$bin" -l 1500 2>/dev/null || true
      return 0
    fi
  done
  return 0
}

follow_log() {
  if command -v logread >/dev/null 2>&1; then
    logread -f 2>/dev/null || true
    return 0
  fi
  for bin in /sbin/logread /usr/sbin/logread /usr/libexec/logread-ubox; do
    if [ -x "$bin" ]; then
      "$bin" -f 2>/dev/null || true
      return 0
    fi
  done
  return 0
}

is_firewall_line() {
  line="$1"
  case "$line" in
    *INFRA_PORT_HIT:*|*INFRA_PORT_BLOCK:*|*INFRA_PORT_OTHER:*) return 0 ;;
  esac
  case "$line" in
    *SRC=*) ;;
    *) return 1 ;;
  esac
  case "$line" in
    *DPT=[0-9]*) ;;
    *)
      case "$line" in
        *PROTO=ICMP*) return 0 ;;
      esac
      return 1
      ;;
  esac
  case "$line" in
    *DROP*|*REJECT*|*BLOCK*|*ALLOW*|*ACCEPT*|*PASS*) return 0 ;;
  esac
  return 1
}

refresh_persist_file() {
  [ "$PERSIST_ENABLED" = 1 ] || return 0
  mkdir -p "$PERSIST_DIR" 2>/dev/null || return 1
  PERSIST_FILE="$PERSIST_DIR/firewall-$(date +%Y-%m-%d).log"
}

write_stats() {
  files=0
  kb=0
  if [ "$PERSIST_ENABLED" = 1 ] && [ -d "$PERSIST_DIR" ]; then
    files="$(find "$PERSIST_DIR" -type f -name 'firewall-*.log' 2>/dev/null | wc -l | tr -d '[:space:]')"
    kb="$(du -sk "$PERSIST_DIR" 2>/dev/null | awk '{print $1}' | tr -d '[:space:]')"
    case "$files" in ''|*[!0-9]*) files=0 ;; esac
    case "$kb" in ''|*[!0-9]*) kb=0 ;; esac
  fi
  printf '%s %s\n' "$files" "$kb" > "$STATS_FILE" 2>/dev/null || true
}

read_stats() {
  files=0
  kb=0
  if [ -f "$STATS_FILE" ]; then
    read -r files kb < "$STATS_FILE" || true
    case "$files" in ''|*[!0-9]*) files=0 ;; esac
    case "$kb" in ''|*[!0-9]*) kb=0 ;; esac
  else
    write_stats
    if [ -f "$STATS_FILE" ]; then
      read -r files kb < "$STATS_FILE" || true
      case "$files" in ''|*[!0-9]*) files=0 ;; esac
      case "$kb" in ''|*[!0-9]*) kb=0 ;; esac
    fi
  fi
}

status_json() {
  count=0
  if [ -f "$RING" ]; then
    count="$(wc -l < "$RING" | tr -d '[:space:]')"
    case "$count" in ''|*[!0-9]*) count=0 ;; esac
  fi
  read_stats
  storage=tmpfs
  [ "$PERSIST_ENABLED" = 1 ] && storage=tmpfs+disk
  printf '{"count":%s,"cap":%s,"storage":"%s","persist_enabled":%s,"persist_directory":"%s","persist_days":%s,"persist_max_mb":%s,"persist_files":%s,"persist_kb":%s}\n' \
    "$count" "$CAP" "$storage" "$PERSIST_ENABLED" "$(json_escape "$PERSIST_DIR")" \
    "$PERSIST_DAYS" "$PERSIST_MAX_MB" "$files" "$kb"
}

write_status() {
  mkdir -p "$(dirname "$STATUS_FILE")"
  status_json > "$STATUS_FILE.tmp" 2>/dev/null || true
  mv "$STATUS_FILE.tmp" "$STATUS_FILE" 2>/dev/null || true
}

status() {
  flush_persist 2>/dev/null || true
  status_json
}

prune_persist() {
  [ "$PERSIST_ENABLED" = 1 ] || return 0
  [ -d "$PERSIST_DIR" ] || return 0
  # Pruning walks the directory and calls du(1); do it at most once a minute.
  stamp="$(date +%s)"
  if [ -f "$PRUNE_STAMP" ]; then
    last="$(cat "$PRUNE_STAMP" 2>/dev/null || echo 0)"
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ $((stamp - last)) -ge 60 ] || { write_stats; return 0; }
  fi
  printf '%s\n' "$stamp" > "$PRUNE_STAMP" 2>/dev/null || true
  if [ "$PERSIST_DAYS" -gt 0 ]; then
    find "$PERSIST_DIR" -type f -name 'firewall-*.log' -mtime +"$PERSIST_DAYS" -delete 2>/dev/null || true
  fi
  max_kb=$((PERSIST_MAX_MB * 1024))
  if [ "$max_kb" -gt 0 ]; then
    while :; do
      kb="$(du -sk "$PERSIST_DIR" 2>/dev/null | awk '{print $1}')"
      case "$kb" in ''|*[!0-9]*) break ;; esac
      [ "$kb" -le "$max_kb" ] && break
      oldest="$(ls -1tr "$PERSIST_DIR"/firewall-*.log 2>/dev/null | head -n 1 || true)"
      [ -n "$oldest" ] || break
      rm -f "$oldest"
    done
  fi
  write_stats
}

flush_persist() {
  [ "$PERSIST_ENABLED" = 1 ] || return 0
  [ -s "$BUFFER" ] || return 0
  lock_take 5 || return 0
  refresh_persist_file || return 0
  flushing="${BUFFER}.flush.$$"
  mv "$BUFFER" "$flushing" 2>/dev/null || return 0
  cat "$flushing" >> "$PERSIST_FILE" 2>/dev/null || true
  rm -f "$flushing"
  prune_persist || true
}

append_persist() {
  [ "$PERSIST_ENABLED" = 1 ] || return 0
  mkdir -p "$(dirname "$BUFFER")" 2>/dev/null || return 0
  printf '%s\n' "$1" >> "$BUFFER" 2>/dev/null || return 0
  PERSIST_TICK=$((PERSIST_TICK + 1))
  if [ $((PERSIST_TICK % 200)) -eq 0 ]; then
    flush_persist
  fi
}

last_persisted_line() {
  [ "$PERSIST_ENABLED" = 1 ] || return 0
  newest="$(ls -1t "$PERSIST_DIR"/firewall-*.log 2>/dev/null | head -n 1 || true)"
  if [ -n "$newest" ] && [ -s "$newest" ]; then
    tail -n 1 "$newest"
  elif [ -s "$BUFFER" ]; then
    tail -n 1 "$BUFFER"
  fi
}

trim_ring() {
  mkdir -p "$(dirname "$RING")"
  [ -f "$RING" ] || : > "$RING"
  lines="$(wc -l < "$RING" | tr -d '[:space:]')"
  case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
  [ "$lines" -gt "$CAP" ] || { write_status; return 0; }
  next="${RING}.tmp.$$"
  awk 'NF && !seen[$0]++' "$RING" | tail -n "$CAP" > "$next"
  mv "$next" "$RING"
  flush_persist
  write_status
}

# Add the logread tail to the ring, and continue the disk history right after
# the line that was persisted last. A restart therefore neither loses nor
# duplicates lines.
seed() {
  mkdir -p "$(dirname "$RING")"
  [ -f "$RING" ] || : > "$RING"
  tail_file="${TMP_DIR}/log-viewer-tail.$$"
  read_log > "$tail_file" 2>/dev/null || : > "$tail_file"

  marker="$(last_persisted_line)"
  skip=0
  if [ -n "$marker" ] && grep -Fxq -- "$marker" "$tail_file" 2>/dev/null; then
    skip=1
  fi

  while IFS= read -r line; do
    is_firewall_line "$line" || continue
    printf '%s\n' "$line" >> "$RING"
    if [ "$skip" = 1 ]; then
      [ "$line" = "$marker" ] && skip=0
      continue
    fi
    append_persist "$line"
  done < "$tail_file"
  rm -f "$tail_file"
  flush_persist
  trim_ring
}

update() {
  lock_take 10 || { echo 'history is busy, retry shortly' >&2; return 1; }
  seed
  status
}

clear_all() {
  lock_take 10 || { echo 'history is busy, retry shortly' >&2; return 1; }
  rm -f "$RING" "$BUFFER"
  if [ -d "$PERSIST_DIR" ]; then
    find "$PERSIST_DIR" -type f -name 'firewall-*.log' -delete 2>/dev/null || true
  fi
  rm -f "$STATS_FILE" "$PRUNE_STAMP"
  write_stats
  status
}

follow() {
  load_config
  refresh_persist_file
  # The ring only has to be rebuilt after a reboot; on a restart it already
  # holds the recent history and re-reading logread would duplicate lines.
  if [ -s "$RING" ]; then
    trim_ring
  else
    seed
  fi
  flush_persist
  failures=0
  while true; do
    started="$(date +%s)"
    follow_log | {
      count=0
      while IFS= read -r line; do
        is_firewall_line "$line" || continue
        printf '%s\n' "$line" >> "$RING"
        append_persist "$line"
        count=$((count + 1))
        if [ "$count" -ge 50 ]; then
          trim_ring
          count=0
        fi
      done
    }
    flush_persist
    trim_ring
    elapsed=$(( $(date +%s) - started ))
    if [ "$elapsed" -lt 5 ]; then
      failures=$((failures + 1))
    else
      failures=0
    fi
    if [ "$failures" -ge 2 ]; then
      # logread without follow support: fall back to a timed snapshot.
      failures=0
      sleep 15
      seed >/dev/null 2>&1 || true
    else
      sleep 2
    fi
  done
}

configure() {
  enabled="${1:-0}"
  directory="${2:-/srv/log-viewer}"
  days="${3:-7}"
  max_mb="${4:-32}"
  ring="${5:-500}"
  case "$enabled" in 0|1) ;; *) echo 'enabled must be 0 or 1' >&2; exit 2 ;; esac
  case "$directory" in
    /srv/*|/mnt/*|/media/*|/etc/log-viewer/*|/tmp/*) ;;
    *) echo 'directory must be under /srv, /mnt, /media, /etc/log-viewer or /tmp' >&2; exit 2 ;;
  esac
  case "$directory" in *[!a-zA-Z0-9_./-]*) echo 'invalid directory' >&2; exit 2 ;; esac
  case "$days" in ''|*[!0-9]*) echo 'days must be a number' >&2; exit 2 ;; esac
  case "$max_mb" in ''|*[!0-9]*) echo 'max_mb must be a number' >&2; exit 2 ;; esac
  case "$ring" in ''|*[!0-9]*) echo 'ring must be a number' >&2; exit 2 ;; esac
  [ "$days" -ge 1 ] && [ "$days" -le 3650 ] || { echo 'days must be 1..3650' >&2; exit 2; }
  [ "$max_mb" -ge 1 ] && [ "$max_mb" -le 8192 ] || { echo 'max_mb must be 1..8192' >&2; exit 2; }
  [ "$ring" -ge 100 ] && [ "$ring" -le 5000 ] || { echo 'ring must be 100..5000' >&2; exit 2; }
  if [ "$enabled" = 1 ]; then
    mkdir -p "$directory" || { echo 'cannot create history directory' >&2; exit 1; }
    : > "$directory/.write-test" 2>/dev/null || { echo 'history directory is not writable' >&2; exit 1; }
    rm -f "$directory/.write-test"
  fi
  uci set log-viewer.history=history 2>/dev/null || true
  uci set "log-viewer.history.enabled=$enabled"
  uci set "log-viewer.history.directory=$directory"
  uci set "log-viewer.history.days=$days"
  uci set "log-viewer.history.max_mb=$max_mb"
  uci set "log-viewer.history.ring=$ring"
  uci commit log-viewer
  "$HISTORY_INIT" restart >/dev/null 2>&1 || true
  load_config
  status
}

load_config

case "${1:-}" in
  update) update ;;
  status) status ;;
  clear) clear_all ;;
  follow)
    if pid_running; then
      echo 'another collector is already running' >&2
      exit 0
    fi
    printf '%s\n' "$$" > "$PID_FILE" 2>/dev/null || true
    trap 'flush_persist 2>/dev/null; write_status 2>/dev/null; rm -f "$PID_FILE"; exit 0' INT TERM
    follow
    ;;
  configure)
    shift
    configure "$@"
    ;;
  *) echo 'usage: log-viewer-history {update|status|clear|follow|configure <0|1> <dir> <days> <max_mb> [ring]}' >&2; exit 2 ;;
esac
