#!/bin/sh
# Reverse DNS helper for the source drawer.
#
# The lookup is bounded by `timeout` because a dead resolver would otherwise
# block the rpcd/cgi request for the resolver's full retry window.
set -eu

usage() {
  echo 'usage: log-viewer-ip reverse <ipv4|ipv6>' >&2
  exit 2
}

[ "${1:-}" = reverse ] || usage
ip="${2:-}"

valid_ipv4() {
  case "$1" in
    *[!0-9.]*|'') return 1 ;;
  esac
  old_ifs="$IFS"
  IFS=.
  # shellcheck disable=SC2086
  set -- $1
  IFS="$old_ifs"
  [ "$#" -eq 4 ] || return 1
  for octet in "$@"; do
    case "$octet" in ''|*[!0-9]*) return 1 ;; esac
    [ "$octet" -le 255 ] || return 1
  done
  return 0
}

valid_ipv6() {
  case "$1" in
    ''|*[!0-9a-fA-F:.]*) return 1 ;;
  esac
  case "$1" in
    *:*) ;;
    *) return 1 ;;
  esac
  [ "${#1}" -le 45 ] || return 1
  # Not a full validator: reject the shapes that would confuse nslookup(1).
  case "$1" in
    *:::*) return 1 ;;
  esac
  return 0
}

if ! valid_ipv4 "$ip" && ! valid_ipv6 "$ip"; then
  printf '{"error":"invalid IP"}\n'
  exit 0
fi

name=""
if command -v nslookup >/dev/null 2>&1; then
  if command -v timeout >/dev/null 2>&1; then
    name="$(timeout 4 nslookup "$ip" 2>/dev/null | sed -n -e 's/^[[:space:]]*[Nn]ame:[[:space:]]*//p' -e 's/^.*[Nn]ame[[:space:]]*=[[:space:]]*//p' | head -n 1)"
  else
    name="$(nslookup "$ip" 2>/dev/null | sed -n -e 's/^[[:space:]]*[Nn]ame:[[:space:]]*//p' -e 's/^.*[Nn]ame[[:space:]]*=[[:space:]]*//p' | head -n 1)"
  fi
fi
name="$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n' | sed 's/\.$//')"
printf '{"ip":"%s","name":"%s"}\n' "$ip" "$name"
