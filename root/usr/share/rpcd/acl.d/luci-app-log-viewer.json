{
  "luci-app-log-viewer": {
    "description": "Grant access to firewall log procedures",
    "read": {
      "cgi-io": [
        "exec"
      ],
      "ubus": {
        "file": [
          "read",
          "exec"
        ],
        "log": [
          "read"
        ]
      },
      "file": {
        "/sbin/logread*": [
          "exec"
        ],
        "/usr/sbin/logread*": [
          "exec"
        ],
        "/usr/libexec/logread-ubox*": [
          "exec"
        ],
        "/usr/bin/flint4-geoip": [
          "exec"
        ],
        "/usr/sbin/infra-port-watch get": [
          "exec"
        ],
        "/usr/sbin/log-viewer-history": [
          "exec"
        ],
        "/usr/sbin/log-viewer-query": [
          "exec"
        ],
        "/usr/sbin/log-viewer-ip": [
          "exec"
        ],
        "/tmp/log-viewer/events.status": [
          "read"
        ],
        "/tmp/log-viewer/geoip-update.status": [
          "read"
        ],
        "/etc/log-viewer/policies.json": [
          "read"
        ],
        "/tmp/log-viewer/events.ring": [
          "read"
        ]
      }
    },
    "write": {
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/sbin/infra-port-watch-config": [
          "exec"
        ],
        "/usr/sbin/log-viewer-history": [
          "exec"
        ],
        "/usr/bin/flint4-geoip-update": [
          "exec"
        ]
      }
    }
  }
}
