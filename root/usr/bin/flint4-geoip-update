#!/bin/sh
# Refresh local GeoLite2 Country and ASN databases. Validate downloads before replacement.
set -eu
BASE="${GEOIP_DB_DIR:-/usr/share/GeoIP}"
TMPBASE="${GEOIP_UPDATE_TMP:-/tmp}"
TMP="$TMPBASE/geolite-update.$$"
STATUS="${GEOIP_UPDATE_STATUS:-/tmp/log-viewer/geoip-update.status}"
mkdir -p "$BASE" "$TMP" "$(dirname "$STATUS")"
trap 'rm -rf "$TMP"' EXIT INT TERM

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n'
}

file_size() {
  stat -c %s "$1" 2>/dev/null || echo 0
}

set_status() {
  state="$1"
  message="$2"
  country_bytes="${3:-0}"
  asn_bytes="${4:-0}"
  updated_at="$(date +%s 2>/dev/null || echo 0)"
  printf '{"state":"%s","message":"%s","country_bytes":%s,"asn_bytes":%s,"updated_at":%s}\n' \
    "$state" "$(json_escape "$message")" "$country_bytes" "$asn_bytes" "$updated_at" > "$STATUS.tmp" 2>/dev/null || true
  mv "$STATUS.tmp" "$STATUS" 2>/dev/null || true
}

fail() {
  set_status error "$1"
  echo "$1" >&2
  exit 1
}

if [ "${1:-}" = "--status" ]; then
  if [ -s "$STATUS" ]; then cat "$STATUS"; else printf '{"state":"idle","message":"No update has run yet.","country_bytes":0,"asn_bytes":0,"updated_at":0}\n'; fi
  exit 0
fi

if ! command -v mmdblookup >/dev/null 2>&1; then
  fail "Install libmaxminddb first (apk add libmaxminddb or opkg install libmaxminddb)."
fi

fetch() {
  if command -v uclient-fetch >/dev/null 2>&1; then
    uclient-fetch -O "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$2" "$1"
  else
    echo "Need uclient-fetch or wget." >&2
    return 1
  fi
}

BASEURL=https://github.com/P3TERX/GeoLite.mmdb/raw/download
set_status downloading "Downloading GeoLite2 Country database…" 0 0
fetch "$BASEURL/GeoLite2-Country.mmdb" "$TMP/GeoLite2-Country.mmdb" || fail "Could not download the GeoLite2 Country database."
set_status downloading "Downloaded Country; downloading ASN database…" "$(file_size "$TMP/GeoLite2-Country.mmdb")" 0
fetch "$BASEURL/GeoLite2-ASN.mmdb" "$TMP/GeoLite2-ASN.mmdb" || fail "Could not download the GeoLite2 ASN database."
set_status validating "Downloaded both databases; validating…" "$(file_size "$TMP/GeoLite2-Country.mmdb")" "$(file_size "$TMP/GeoLite2-ASN.mmdb")"

if [ ! -s "$TMP/GeoLite2-Country.mmdb" ] || [ ! -s "$TMP/GeoLite2-ASN.mmdb" ]; then
  fail "GeoIP download is empty; keeping current database files."
fi

# 1.1.1.1 is anycast and may lack country.iso_code in some GeoLite records.
# Use a well-known ordinary unicast IP to validate both database lookup paths.
if ! mmdblookup --file "$TMP/GeoLite2-Country.mmdb" --ip 8.8.8.8 country iso_code >/dev/null; then
  fail "Downloaded Country database failed validation."
fi
if ! mmdblookup --file "$TMP/GeoLite2-ASN.mmdb" --ip 8.8.8.8 autonomous_system_organization >/dev/null; then
  fail "Downloaded ASN database failed validation."
fi

set_status applying "Applying GeoLite2 Country and ASN databases…" "$(file_size "$TMP/GeoLite2-Country.mmdb")" "$(file_size "$TMP/GeoLite2-ASN.mmdb")"
cp "$TMP/GeoLite2-Country.mmdb" "$BASE/GeoLite2-Country.mmdb.new" || fail "Could not stage the Country database."
cp "$TMP/GeoLite2-ASN.mmdb" "$BASE/GeoLite2-ASN.mmdb.new" || fail "Could not stage the ASN database."
mv "$BASE/GeoLite2-Country.mmdb.new" "$BASE/GeoLite2-Country.mmdb" || fail "Could not replace the Country database."
mv "$BASE/GeoLite2-ASN.mmdb.new" "$BASE/GeoLite2-ASN.mmdb" || fail "Could not replace the ASN database."
set_status done "GeoLite2 Country and ASN databases updated." "$(file_size "$BASE/GeoLite2-Country.mmdb")" "$(file_size "$BASE/GeoLite2-ASN.mmdb")"
echo "GeoLite2 Country and ASN databases updated."
