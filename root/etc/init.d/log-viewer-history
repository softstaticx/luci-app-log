#!/bin/sh /etc/rc.common
# START/STOP/USE_PROCD are consumed by /etc/rc.common and procd.
# shellcheck disable=SC2034

# Collector that keeps the tmpfs ring warm even when no browser is open.

START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/log-viewer-history follow
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
