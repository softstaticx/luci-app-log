#!/bin/sh /etc/rc.common
# START/STOP are consumed by /etc/rc.common.
# shellcheck disable=SC2034

# Re-apply the nftables watch rules. fw4 keeps the verdict includes across its
# own reloads, so this only has to run on boot, on WAN ifup, and after a
# configuration change.

START=99
STOP=10

start() {
	/usr/sbin/infra-port-watch apply
}

stop() {
	/usr/sbin/infra-port-watch remove
}

reload() {
	/usr/sbin/infra-port-watch apply
}

restart() {
	stop
	start
}
